# Copy to the repository root as .env.selfhost.local; chmod 600.
# HTTPS origin only; no path, credentials or trailing slash.
DEVELOPER_API_BASE_URL=https://macil.dev.netboxteam.com
# Confirm the actual production API origin with the backend team.
# Set an immutable release label for each deployment (for example the commit SHA).
RELEASE_TAG=local
# Optional catalog file inside the container; otherwise use preserved public data.
PUBLIC_CATALOG_FILE=
