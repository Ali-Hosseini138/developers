# Copy to the REPOSITORY ROOT as .env.selfhost.local; chmod 600.
# Do not paste secret values into chat, tickets, commits or image build arguments.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Existing anon key also works here; this is public, never the service role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_PUBLIC_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_SERVER_SECRET
# Match the current production value. If production has no dedicated secret,
# leave this empty to keep using the SAME service role key as signing fallback.
DEVELOPER_SESSION_SIGNING_SECRET=
# HTTPS origin only; no trailing slash, path, credentials, query or fragment.
DEVELOPER_API_BASE_URL=https://macil.dev.netboxteam.com
# Temporary compatibility ONLY if legacy private Vercel Blob files exist.
BLOB_READ_WRITE_TOKEN=
# Set to a unique immutable release label before each build (e.g. git commit SHA).
RELEASE_TAG=local
