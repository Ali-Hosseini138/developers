server {
    listen 80;
    server_name _;
    client_max_body_size 400m;
    client_body_timeout 650s;

    # Strip only /backend-api/. Preserve Django's trailing slash, query,
    # Authorization and multipart body. Never retry a mutation on another upstream.
    location /backend-api/ {
        proxy_pass ${DEVELOPER_API_BASE_URL}/;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 3;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_set_header Host $proxy_host;
        proxy_set_header Cookie "";
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_next_upstream off;
        proxy_connect_timeout 15s;
        proxy_send_timeout 650s;
        proxy_read_timeout 650s;
    }

    location / {
        proxy_pass http://app:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # The public TLS reverse proxy must overwrite X-Forwarded-Proto.
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_read_timeout 650s;
    }
}
